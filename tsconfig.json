{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "types": ["node", "mocha"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src"],
    "exclude": ["**/*.spec.ts", "src/webview/**"]
}
